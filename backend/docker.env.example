# Environment variables for the API container (Render: Environment tab; locally: copy to docker.env,
# which is git-ignored, then: docker run --env-file backend/docker.env -p 8080:8080 evchargers-api).
# Placeholders only. Never commit real values.

# Anything other than Development enables the strict startup checks
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL (with PostGIS) connection string
ConnectionStrings__Default=Host=your-db-host;Port=5432;Database=your-db;Username=your-user;Password=your-password;SSL Mode=Require

# Supabase project URL (same value as the frontend's VITE_SUPABASE_URL)
Supabase__Url=https://your-project.supabase.co

# Frontend origin allowed by CORS: https, no trailing slash. Add Cors__AllowedOrigins__1, __2... for more.
Cors__AllowedOrigins__0=https://your-app.vercel.app

# Email (Resend). FromAddress must be on a domain verified in Resend.
Resend__ApiKey=re_your_api_key
Email__FromAddress=noreply@your-domain.tn
Email__FromName=EV Chargers Tunisia

# OpenRouteService (geocoding and routes)
OrsApiKey=your-ors-api-key
